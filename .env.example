# demo: offline scripted planner + real local tools; live: real LLM function calling
AGENT_MODE=demo
# Required only in live mode. Never commit your real .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Example only: choose a model enabled for your account that supports function calling.
OPENAI_MODEL=gpt-4.1-mini
MAX_TOOL_ROUNDS=4
MAX_TOOL_CALLS=8
REQUEST_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=20
DATA_DIR=.local
